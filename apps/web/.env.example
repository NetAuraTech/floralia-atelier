# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333
APP_NAME=Floralia Atelier

# Session
SESSION_DRIVER=redis

# Auth guards — which authentication mechanisms are active.
# full/inertia: keep AUTH_GUARD_API unset (session only), set it to true to
# also expose the token-guarded REST API (/api/v1/*) e.g. for a mobile app.
# api flavor: AUTH_GUARD_WEB=false + AUTH_GUARD_API=true (no session guard).
AUTH_GUARD_WEB=true
AUTH_GUARD_API=false
# Default lifetime of issued API tokens (e.g. "30 days", "7d", "24h").
AUTH_API_TOKEN_EXPIRY=30 days
# Reserved for a future OAuth API mode (redirecting non-browser clients after
# a provider callback). Declared so deployments can set it, but not read yet —
# mobile clients complete OAuth in a system browser, then use /api/v1/auth/login.
AUTH_API_CLIENT_URL=

# Database
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=user
PG_PASSWORD=password
PG_DB_NAME=app

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SOCKET=
REDIS_DB=0

# Queue
# redis: jobs are consumed by a separate worker (`node ace queue:work`).
# sync: jobs run inline in the calling process (no worker, no Redis).
QUEUE_DRIVER=redis
# Redis connection used by the queue (see config/redis.ts).
QUEUE_CONNECTION=local
# Worker settings.
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
# Scheduled maintenance tasks (see config/maintenance.ts). Each value is a
# duration string ("1d", "24h", "30m"); "0" disables the task. Unset values
# fall back to a daily schedule.
MAINTENANCE_LOG_PRUNE_SCHEDULE=
MAINTENANCE_BACKUP_RETENTION_SCHEDULE=
# Retention window in days for Log Entry pruning (default 180).
LOG_RETENTION_DAYS=

# Inbound webhooks — signature verification (see config/webhooks.ts).
# WEBHOOK_SECRET is the shared HMAC-SHA256 signing secret; leave empty to
# disable the webhook surface. WEBHOOK_REPLAY_WINDOW bounds accepted clock
# skew in seconds (default 300).
WEBHOOK_SECRET=
WEBHOOK_REPLAY_WINDOW=

# Mail
# MAIL_FROM_ADDRESS is also the contact-form recipient (see
# ContactMailService): the florist's address receives every submission.
MAIL_MAILER=smtp
MAIL_FROM_NAME=${APP_NAME}
MAIL_FROM_ADDRESS=contact@floralia-atelier.fr

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=username
SMTP_PASSWORD=password

# Sentry — the same DSN feeds the Node runtime (config/sentry.ts) and the
# browser bundle (inlined at build time by vite.config.ts). Leave unset to
# disable error reporting on both sides.
# Optional SENTRY_RELEASE overrides the frontend release tag (defaults to the
# app version from package.json).
SENTRY_DSN=<your_dsn_url>

# OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Drive (File Storage)
# Active disk for CMS file uploads and public asset URLs (config/drive.ts).
DRIVE_DISK=fs
# Maximum size in megabytes accepted for file uploads (default 10).
MAX_UPLOAD_SIZE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
R2_KEY=
R2_SECRET=
R2_BUCKET=
R2_ENDPOINT=
# Optional CDN custom domain the public r2 disk serves assets through.
R2_PUBLIC_URL=
# Private R2 bucket for the backup system (no public custom domain). Used by
# the r2-backup disk when BACKUP_STORAGE_DISK=r2-backup.
BACKUP_R2_BUCKET=

# Backup (config/backup.ts — pg_dump pipeline, see the Backup section of the README)
# Disk for backup archives — the CMS Drive disks plus the private r2-backup
# disk for S3/R2 targets that must not be publicly served.
BACKUP_STORAGE_DISK=fs
# Daily backup run time (24h). Sundays run a full backup, the other days a
# differential one.
BACKUP_TIME=02:00
# AES-256-GCM encryption with an auth tag, keyed from APP_KEY.
BACKUP_ENCRYPTION_ENABLED=true
# Retention (Spatie-like rotation)
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
BACKUP_RETENTION_YEARLY=1
# Health check thresholds
BACKUP_MAX_AGE_HOURS=25
BACKUP_MAX_SIZE_MB=500
BACKUP_MIN_FREE_SPACE_GB=5
# Notifications (empty email falls back to MAIL_FROM_ADDRESS)
BACKUP_NOTIFICATION_EMAIL=
BACKUP_NOTIFY_SUCCESS=false
BACKUP_NOTIFY_FAILURE=true
BACKUP_NOTIFY_HEALTH_CHECK=true
# Tables excluded from differential backups (comma-separated; always included
# in full backups).
BACKUP_EXCLUDED_TABLES=

LIMITER_STORE=redis
# Default per-client API rate limit (requests/minute) when a user has no custom limit
API_RATE_LIMIT_DEFAULT=60
# CMS content policies (page builder) — comma-separated
CMS_IFRAME_ALLOWLIST=www.google.com,maps.google.com
CMS_VIDEO_PROVIDERS=youtube,vimeo

# CMS page search (Typesense). Disabled by default — the admin page list
# falls back to its standard filtered query. Set SEARCH_ENABLED=true and point
# at the docker-compose Typesense service to enable full-text search.
SEARCH_ENABLED=false
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=cms_page_translations
TYPESENSE_SEARCH_LIMIT=20
# Sitemap — comma-separated additions (absolute or root-relative URLs) and exclusions (route names, paths, or absolute URLs)
SITEMAP_ADDITIONS=
SITEMAP_EXCLUSIONS=